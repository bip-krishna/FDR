# Copy to .env locally. Never commit credentials.
# All providers start disabled. Zero budget/limits means requests are blocked.

APP_ENV=development
APP_NAME=FDR
API_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./fdr.db

# Provider credentials (server-side only)
SERPAPI_API_KEY=
GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Explicit provider switches
ENABLE_SERPAPI=false
ENABLE_AMADEUS=false
ENABLE_GOOGLE_MAPS=false
ENABLE_GOOGLE_GEOCODING=false
ENABLE_GOOGLE_ROUTES=false
ENABLE_RAIL_PROVIDER=false
ENABLE_GROQ_LAYOVER=false
ENABLE_OPEN_METEO=false

# Hard ceilings; set only after reviewing provider terms and account quotas.
MONTHLY_EXTERNAL_API_BUDGET_INR=0
MAX_EXTERNAL_API_CALLS_PER_DAY=0
MAX_EXTERNAL_API_CALLS_PER_MONTH=0
MAX_FLIGHT_SEARCHES_PER_USER_SEARCH=0
SERPAPI_MAX_CALLS_PER_DAY=0
SERPAPI_MAX_CALLS_PER_MONTH=0
# Set to 0 only after confirming the account's included/free usage; leave blank to block on unknown cost.
SERPAPI_COST_PER_SEARCH_INR=
SERPAPI_TIMEOUT_SECONDS=20
GOOGLE_MAPS_TIMEOUT_SECONDS=20
FLIGHT_DEFAULT_CURRENCY=INR
FLIGHT_GOOGLE_COUNTRY=in
FLIGHT_GOOGLE_LANGUAGE=en
FRONTEND_ORIGINS=http://localhost:3000
MAX_PLACES_LOOKUPS_PER_LAYOVER=0
MAX_GROQ_CALLS_PER_LAYOVER=0
# Google Maps traffic-aware routes use the Routes Compute Routes Pro SKU.
# Google geocoding is a separate SKU. Leave costs blank to block until your billing tier is verified.
GOOGLE_GEOCODING_MAX_CALLS_PER_DAY=0
GOOGLE_GEOCODING_MAX_CALLS_PER_MONTH=0
GOOGLE_GEOCODING_COST_PER_CALL_INR=
GOOGLE_ROUTES_MAX_CALLS_PER_DAY=0
GOOGLE_ROUTES_MAX_CALLS_PER_MONTH=0
GOOGLE_ROUTES_COST_PER_CALL_INR=
MAX_GOOGLE_MAPS_CALLS_PER_TRANSFER=0
# Stage 5 door-to-door estimates use two city geocodes and up to two Routes calls.
MAX_GOOGLE_MAPS_CALLS_PER_JOURNEY=0
AIRPORT_CHECKIN_BUFFER_MINUTES=120
